MONGO_URL=mongodb://localhost:27017
DB_NAME=aov_database
NEXT_PUBLIC_BASE_URL=https://voteafrica-one.preview.emergentagent.com
CORS_ORIGINS=*

# NextAuth
NEXTAUTH_SECRET=aov-super-secret-key-change-in-production-2024
NEXTAUTH_URL=https://voteafrica-one.preview.emergentagent.com

# PayPal (SANDBOX MODE - Replace with production keys)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
